{
  "name": "wexpc1-foundations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test shared/tests/*.test.mjs permissions/tests/*.test.mjs app/tests/*.test.mjs connections/tests/*.test.mjs connections/github/tests/*.test.mjs connections/local/tests/*.test.mjs connections/api/tests/*.test.mjs tools/tests/*.test.mjs UI/tests/*.test.mjs space/tests/*.test.mjs AI/tests/*.test.mjs conversations/tests/*.test.mjs && npm run check:boundaries",
    "test:shared": "npm run build && node --test shared/tests/*.test.mjs",
    "test:permissions": "npm run build && node --test permissions/tests/*.test.mjs",
    "test:app": "npm run build && node --test app/tests/*.test.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "start:headless": "npm run build && node dist/app/src/main.js",
    "build:shared": "node tools/build-module.mjs shared",
    "build:permissions": "node tools/build-module.mjs permissions",
    "build:app": "node tools/build-module.mjs app",
    "test:connections": "npm run build && node --test connections/tests/*.test.mjs connections/github/tests/*.test.mjs connections/local/tests/*.test.mjs",
    "test:space": "npm run build && node --test space/tests/*.test.mjs",
    "test:api": "npm run build && node --test connections/api/tests/*.test.mjs",
    "test:ai": "npm run build && node --test AI/tests/*.test.mjs",
    "test:conversations": "npm run build && node --test conversations/tests/*.test.mjs",
    "test:github": "npm run build && node --test connections/github/tests/*.test.mjs",
    "test:local": "npm run build && node --test connections/local/tests/*.test.mjs",
    "build:desktop": "npm run build && node tools/build-desktop.mjs",
    "start:desktop": "npm run build:desktop && electron dist/app/src/desktop-main.js",
    "verify:desktop": "npm run build:desktop && node tools/verify-desktop.mjs",
    "test:ui": "npm run build && node --test UI/tests/*.test.mjs",
    "package:windows": "npm run build:desktop && node tools/package-windows.mjs",
    "setup:github-upstream": "node tools/checkout-github-upstream.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "45.2.1",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "octokit": "5.0.5",
    "@modelcontextprotocol/sdk": "1.26.0"
  }
}
