{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "shared/src/**/*.ts",
    "permissions/src/**/*.ts",
    "app/src/**/*.ts",
    "connections/src/**/*.ts",
    "space/src/**/*.ts",
    "connections/api/src/**/*.ts",
    "AI/src/**/*.ts",
    "conversations/src/**/*.ts",
    "connections/github/src/**/*.ts",
    "connections/local/src/**/*.ts",
    "UI/src/**/*.ts",
    "UI/src/**/*.tsx"
  ]
}
